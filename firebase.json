{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "apphosting": [
    {
      "backendId": "beatrix-web",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        ".claude",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "functions",
        "terraform",
        ".env*",
        "src/data/profile.json",
        "public/*.docx"
      ]
    }
  ]
}

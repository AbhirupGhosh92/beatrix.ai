rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allowlist for the Google-login gate. A signed-in user may read only their own entry
    // (document ID = their verified email, lowercase); listing and writes are denied.
    // The Cloud Functions use the Admin SDK, which bypasses these rules.
    match /allowed_emails/{email} {
      allow get: if request.auth != null
        && request.auth.token.email_verified == true
        && email == request.auth.token.email.lower();
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

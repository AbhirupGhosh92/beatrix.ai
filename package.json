{
  "name": "beatrix.ai",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint",
    "clean": "rm -rf .next out next-env.d.ts *.tsbuildinfo",
    "functions:build": "pnpm --prefix functions run build",
    "deploy:functions": "firebase deploy --only functions,firestore:rules,storage",
    "infra:preflight": "bash scripts/env-preflight.sh",
    "functions:serve": "pnpm --prefix functions run build && firebase emulators:start --only functions,firestore,storage,auth",
    "infra:recreate": "bash scripts/recreate-environment.sh",
    "infra:seed": "bash scripts/seed-data.sh",
    "infra:check": "bash scripts/check-infra.sh"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@uiw/react-json-view": "2.0.0-alpha.44",
    "firebase": "^13.1.0",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~6.0.3"
  }
}
